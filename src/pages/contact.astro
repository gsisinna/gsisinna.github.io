---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const contactUrl = new URL("/contact/", siteUrl).toString();
const contactJsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Contact · Gabriele Sisinna",
  url: contactUrl,
  description: "Contact page for project inquiries, collaborations, and robotics/software architecture work.",
  inLanguage: "en"
};
---

<BaseLayout
  title="Contact · Gabriele Sisinna"
  description="Get in touch about robotics software, architecture support, prototyping, or collaboration."
  jsonLd={contactJsonLd}
>
  <div class="contact-grid">
    <header class="page-head fade-in">
      <p class="kicker">contact</p>
      <h1>Let&apos;s talk</h1>
      <p class="lead">
        Working on a robotics, automation, or software architecture project? Send a short message.
        I&apos;m open to collaborations, technical discussions, and hands-on implementation work.
      </p>
      <p class="muted contact-alt">
        Prefer something else? Find me on
        <a href="https://www.linkedin.com/in/gabriele-sisinna-4a6081109/" target="_blank" rel="noreferrer noopener">LinkedIn</a>
        or <a href="https://github.com/gsisinna" target="_blank" rel="noreferrer noopener">GitHub</a>.
      </p>
    </header>

    <form
      class="panel contact-form"
      method="POST"
      action="https://formspree.io/f/xzdakabw"
      accept-charset="UTF-8"
      autocomplete="on"
    >
      <input type="hidden" name="_subject" value="New message from gsisinna.github.io" />
      <input type="hidden" name="_next" value="https://gsisinna.github.io/contact/" />
      <label aria-hidden="true" class="honeypot">
        Do not fill this out
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
      </label>

      <div class="field-row">
        <label class="field">
          <span>Name</span>
          <input type="text" name="name" required minlength="2" maxlength="100" autocomplete="name" placeholder="Your name" />
        </label>
        <label class="field">
          <span>Email</span>
          <input
            type="email"
            name="email"
            required
            maxlength="254"
            autocomplete="email"
            autocapitalize="off"
            spellcheck="false"
            inputmode="email"
            placeholder="you@example.com"
          />
        </label>
      </div>

      <label class="field">
        <span>Subject</span>
        <input
          type="text"
          name="subject"
          required
          minlength="3"
          maxlength="150"
          autocomplete="off"
          placeholder="Project, collaboration, question..."
        />
      </label>

      <label class="field">
        <span>Message</span>
        <textarea name="message" required minlength="10" maxlength="5000" rows="7" placeholder="Write your message..."></textarea>
      </label>

      <div class="form-footer">
        <button type="submit" class="button button-primary">Send message</button>
        <p class="muted">
          Sent via Formspree (<a href="/privacy/">privacy</a>). Please don&apos;t include passwords or sensitive data.
        </p>
      </div>
    </form>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(1.5rem, 5vw, 3.5rem);
    align-items: start;
  }

  .contact-alt a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .contact-form {
    display: grid;
    gap: 1rem;
    padding: clamp(1.1rem, 3vw, 1.5rem);
  }

  .honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .field-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .field {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .field span {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .field :where(input, textarea) {
    width: 100%;
    padding: 0.7rem 0.8rem;
    border: 1px solid var(--line-strong);
    border-radius: 8px;
    background: var(--bg);
    color: var(--ink-strong);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 140ms ease, box-shadow 140ms ease;
  }

  .field textarea {
    resize: vertical;
    min-height: 9rem;
  }

  .field :where(input, textarea)::placeholder {
    color: var(--faint);
  }

  .field :where(input, textarea):focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }

  .form-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .form-footer .muted {
    flex: 1 1 14rem;
    font-size: 0.8rem;
  }

  .form-footer a {
    color: inherit;
  }

  @media (max-width: 820px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .field-row {
      grid-template-columns: 1fr;
    }

    .form-footer .button {
      width: 100%;
    }
  }
</style>
