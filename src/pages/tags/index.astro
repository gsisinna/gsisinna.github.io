---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate, getPublishedTagSummaries } from "../../lib/content";

const tags = await getPublishedTagSummaries();
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const tagsUrl = new URL("/tags/", siteUrl).toString();
const tagsJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Topics · Gabriele Sisinna",
    url: tagsUrl,
    description: "Browse notes by topic: robotics, ROS 2, simulation, C++, software architecture, and more.",
    inLanguage: "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: "Tags", item: tagsUrl }
    ]
  }
];
---

<BaseLayout
  title="Topics · Gabriele Sisinna"
  description="Browse notes by topic: robotics, ROS 2, simulation, C++, software architecture, and more."
  jsonLd={tagsJsonLd}
>
  <header class="page-head fade-in">
    <p class="kicker">ls ~/tags</p>
    <h1>Topics</h1>
    <p class="lead">Every topic I've written about, most covered first. Pick one to see all related notes.</p>
  </header>

  {tags.length === 0 ? (
    <p class="muted">No topics yet.</p>
  ) : (
    <ul class="tag-grid" aria-label="All topics" data-reveal="stagger">
      {tags.map((tag) => (
        <li class="tag-card lift">
          <div class="tag-top">
            <a class="tag-name" href={`/tags/${tag.slug}/`}>#{tag.name}</a>
            <span class="tag-count">{tag.count} note{tag.count === 1 ? "" : "s"}</span>
          </div>
          <p class="tag-latest">
            <span class="muted">Latest · {formatDate(tag.latest.data.date)}</span>
            <span>{tag.latest.data.title}</span>
          </p>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .tag-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }

  .tag-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .tag-top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .tag-name {
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-weight: 600;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  /* Whole card is clickable via the tag link */
  .tag-name::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .tag-card:hover .tag-name {
    color: var(--accent);
  }

  .tag-count {
    flex-shrink: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .tag-latest {
    display: grid;
    gap: 0.15rem;
    font-size: 0.88rem;
    line-height: 1.4;
  }

  .tag-latest .muted {
    font-family: var(--font-mono);
    font-size: 0.72rem;
  }
</style>
