---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedTagSummaries } from "../../lib/content";

const tags = await getPublishedTagSummaries();
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const tagsUrl = new URL("/tags/", siteUrl).toString();
const tagsJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Tags | gsisinna",
    url: tagsUrl,
    description: "Browse notes by topic tags.",
    inLanguage: "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: "Tags", item: tagsUrl }
    ]
  }
];
---

<BaseLayout
  title="Tags | gsisinna"
  description="Browse notes by tag."
  jsonLd={tagsJsonLd}
>
  <header class="page-head fade-in">
    <p class="kicker">ls ~/tags</p>
    <h1>Tags</h1>
    <p class="lead">Browse notes by topic.</p>
  </header>

  {tags.length === 0 ? (
    <p class="muted">No tags yet.</p>
  ) : (
    <ul class="tag-grid" aria-label="All tags">
      {tags.map((tag) => (
        <li>
          <a class="tag-card" href={`/tags/${tag.slug}/`}>
            <span class="tag-name">#{tag.name}</span>
            <span class="tag-count">{tag.count}</span>
          </a>
        </li>
      ))}
    </ul>
  )}
</BaseLayout>

<style>
  .tag-grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
    grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));
  }

  .tag-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
    text-decoration: none;
    transition: border-color 140ms ease, color 140ms ease;
  }

  .tag-card:hover {
    border-color: rgba(94, 230, 160, 0.4);
  }

  .tag-card:hover .tag-name {
    color: var(--accent);
  }

  .tag-name {
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    overflow-wrap: anywhere;
  }

  .tag-count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
