---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPublishedJournalEntries, getPublishedTagSummaries, slugifyTag } from "../../lib/content";

export async function getStaticPaths() {
  const tags = await getPublishedTagSummaries();
  return tags.map((tag) => ({
    params: { tag: tag.slug },
    props: { tagName: tag.name, tagCount: tag.count }
  }));
}

const { tag } = Astro.params;
const { tagName, tagCount } = Astro.props as { tagName: string; tagCount: number };

if (!tag) {
  throw new Error("Missing tag param");
}

const allEntries = await getPublishedJournalEntries();
const entries = allEntries.filter((entry) => entry.data.tags.some((entryTag) => slugifyTag(entryTag) === tag));
const relatedTags = [
  ...entries
    .flatMap((entry) => entry.data.tags)
    .filter((entryTag) => slugifyTag(entryTag) !== tag)
    .reduce((counts, name) => counts.set(name, (counts.get(name) ?? 0) + 1), new Map<string, number>())
]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 8)
  .map(([name]) => name);
const description = `${tagCount} note${tagCount === 1 ? "" : "s"} by Gabriele Sisinna about ${tagName}.`;
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const tagUrl = new URL(`/tags/${tag}/`, siteUrl).toString();
const tagJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `#${tagName} · Gabriele Sisinna`,
    url: tagUrl,
    description,
    inLanguage: "en"
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: "Tags", item: new URL("/tags/", siteUrl).toString() },
      { "@type": "ListItem", position: 3, name: tagName, item: tagUrl }
    ]
  }
];
---

<BaseLayout title={`#${tagName} · Notes · Gabriele Sisinna`} description={description} jsonLd={tagJsonLd}>
  <header class="page-head fade-in">
    <a class="text-link" href="/tags/">← All topics</a>
    <h1>#{tagName}</h1>
    <p class="lead">{tagCount} note{tagCount === 1 ? "" : "s"} about {tagName}, newest first.</p>
    {relatedTags.length > 0 && (
      <div class="meta-row" aria-label="Related topics">
        <span class="muted related-label">Related:</span>
        {relatedTags.map((name) => (
          <a class="pill" href={`/tags/${slugifyTag(name)}/`}>#{name}</a>
        ))}
      </div>
    )}
  </header>

  <section class="post-list" aria-label={`Notes about ${tagName}`}>
    {entries.map((entry) => <PostRow entry={entry} activeTag={tag} />)}
  </section>
</BaseLayout>

<style>
  .related-label {
    font-size: 0.88rem;
    margin-right: 0.15rem;
  }
</style>
