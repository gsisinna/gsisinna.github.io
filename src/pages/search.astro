---
import BaseLayout from "../layouts/BaseLayout.astro";

const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const searchUrl = new URL("/search/", siteUrl).toString();
const searchJsonLd = {
  "@context": "https://schema.org",
  "@type": "SearchResultsPage",
  name: "Search · Gabriele Sisinna",
  url: searchUrl,
  description: "Search notes and articles on gsisinna.github.io.",
  inLanguage: "en"
};
---

<BaseLayout
  title="Search · Gabriele Sisinna"
  description="Search notes, architecture write-ups, and project posts."
  noindex={true}
  jsonLd={searchJsonLd}
>
  <header class="page-head fade-in">
    <p class="kicker">grep -ri</p>
    <h1>Search</h1>
    <label class="search-box" for="site-search-input">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <circle cx="11" cy="11" r="7" />
        <path d="m20 20-3.5-3.5" />
      </svg>
      <span class="sr-only">Search notes</span>
      <input
        id="site-search-input"
        type="search"
        name="q"
        placeholder="Titles, excerpts, tags..."
        autocomplete="off"
        spellcheck="false"
        autofocus
      />
    </label>
    <div id="search-empty" class="meta-row">
      <span class="muted" style="font-size:0.88rem; margin-right:0.25rem;">Try:</span>
      <button class="pill search-chip" type="button" data-query="robotics">robotics</button>
      <button class="pill search-chip" type="button" data-query="software architecture">software architecture</button>
      <button class="pill search-chip" type="button" data-query="astro">astro</button>
      <button class="pill search-chip" type="button" data-query="java">java</button>
    </div>
    <p id="search-status" class="muted" aria-live="polite">Loading index...</p>
  </header>

  <section>
    <div id="search-results" class="post-list search-results"></div>
    <div id="search-pagination" class="search-pagination" hidden>
      <button type="button" class="button" id="search-prev">Previous</button>
      <span class="muted" id="search-page-label">Page 1 of 1</span>
      <button type="button" class="button" id="search-next">Next</button>
    </div>
  </section>

  <script src="../scripts/search-page.ts"></script>

  <style>
    .search-box {
      display: flex;
      align-items: center;
      gap: 0.7rem;
      margin-top: 0.5rem;
      padding: 0.8rem 1rem;
      border: 1px solid var(--line-strong);
      border-radius: 10px;
      background: var(--surface);
      transition: border-color 140ms ease, box-shadow 140ms ease;
    }

    .search-box:focus-within {
      border-color: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-dim);
    }

    .search-box svg {
      width: 1.1rem;
      height: 1.1rem;
      color: var(--muted);
      flex-shrink: 0;
    }

    .search-box input {
      flex: 1;
      min-width: 0;
      border: 0;
      outline: 0;
      background: transparent;
      color: var(--ink-strong);
      font: inherit;
      font-size: 1.05rem;
    }

    .search-box input::placeholder {
      color: var(--muted);
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .search-chip {
      cursor: pointer;
      font-family: var(--font-mono);
    }

    .search-chip:hover {
      color: var(--ink-strong);
      border-color: var(--accent-line);
    }

    .search-results:empty {
      border-top: 0;
    }

    .search-results :global(mark) {
      background: rgba(242, 196, 109, 0.22);
      color: var(--ink-strong);
      border-radius: 3px;
      padding: 0 0.1em;
    }

    .search-pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      margin-top: 1.5rem;
    }

    .search-pagination[hidden] {
      display: none;
    }
  </style>
</BaseLayout>
