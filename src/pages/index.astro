---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostRow from "../components/PostRow.astro";
import { getPublishedJournalEntries } from "../lib/content";

const entries = await getPublishedJournalEntries();
const latest = entries.slice(0, 3);
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const homeUrl = new URL("/", siteUrl).toString();
const notesUrl = new URL("/journal/", siteUrl).toString();
const contactUrl = new URL("/contact/", siteUrl).toString();
const searchUrl = new URL("/search/", siteUrl).toString();
const githubUrl = "https://github.com/gsisinna";
const linkedInUrl = "https://www.linkedin.com/in/gabriele-sisinna-4a6081109/";
const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "gsisinna",
    url: homeUrl,
    description:
      "Personal blog of Gabriele Sisinna about robotics software, projects, and notes.",
    inLanguage: "en",
    potentialAction: {
      "@type": "SearchAction",
      target: `${searchUrl}?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Gabriele Sisinna",
    url: homeUrl,
    jobTitle: "Senior Robotics Software Engineer",
    address: {
      "@type": "PostalAddress",
      addressLocality: "Bologna",
      addressCountry: "IT"
    },
    knowsAbout: [
      "Robotics",
      "C++",
      "Python",
      "Linux",
      "Arduino",
      "Electronics",
      "3D Printing",
      "Rapid Prototyping",
      "ROS",
      "Robotics Simulation",
      "Control Systems",
      "Software Architecture"
    ],
    sameAs: [githubUrl, contactUrl, linkedInUrl].filter(Boolean),
    mainEntityOfPage: homeUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Main site sections",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", url: homeUrl },
      { "@type": "ListItem", position: 2, name: "Notes", url: notesUrl },
      { "@type": "ListItem", position: 3, name: "Contact", url: contactUrl }
    ]
  }
];

const experience = [
  {
    period: "2024 – now",
    role: "Robotics Software Engineer",
    place: "FlexLink · Bologna",
    note: "Modular C++/Python software for autonomous and collaborative robotics: reusable components, CI/CD, and system integration."
  },
  {
    period: "2022 – 2023",
    role: "Robotics Engineer",
    place: "Lab0 · Genova",
    note: "Simulation, middleware, C++/Python development, Docker/Git workflows, hardware integration, and prototyping."
  },
  {
    period: "2021 – 2022",
    role: "Robotics Technician / Software Engineer",
    place: "Istituto Italiano di Tecnologia · Genova",
    note: "iCub assembly, testing and diagnostics, YARP-based test activities, Docker deployments, and support for demos."
  },
  {
    period: "2021",
    role: "Master Thesis",
    place: "Università di Pisa",
    note: "Bio-inspired control system for the humanoid robot Abel, with a ROS-based architecture in Python."
  },
  {
    period: "2020 – 2021",
    role: "Lab Training, Robotics",
    place: "Scuola Superiore Sant'Anna · Pisa",
    note: "7-DOF KUKA simulation with ROS, MoveIt and Gazebo: CLIK, PID control, and trajectory planning."
  }
];

const skillGroups = [
  { title: "Software", items: ["C++", "Python", "CMake", "Software Architecture", "Unit Testing", "CI/CD"] },
  { title: "Robotics", items: ["ROS", "Simulation", "Control Systems", "Industrial Manipulators", "Middleware", "System Integration"] },
  { title: "Systems", items: ["Linux", "Docker", "Git / GitLab", "DevOps", "Arduino", "Embedded Prototyping"] },
  { title: "Hardware", items: ["Electronics", "3D Printing", "CAD / Onshape", "Rapid Prototyping", "Hardware Integration"] }
];

const education = [
  { title: "MSc Bionics Engineering (Biorobotics)", school: "Scuola Superiore Sant'Anna", period: "2018–2021" },
  { title: "BSc Biomedical Engineering", school: "Università di Pisa", period: "2014–2018" }
];

const certifications = [
  { title: "Software Architecture Foundations", year: "2024" },
  { title: "Learning C++", year: "2023" },
  { title: "Learning Python", year: "2020" },
  { title: "Programming Foundations: Object-Oriented Design", year: "2020" },
  { title: "Programming Foundations: Algorithms", year: "2020" }
];

const hobbies = [
  { label: "Guitar", value: "How I slow down. Good things are built one repeat at a time." },
  { label: "Motorcycle", value: "Freedom and focus at once: the same flow I look for when building software." },
  { label: "Trekking", value: "How I reset. Mountains feel like home after growing up near Mount Etna." }
];
---

<BaseLayout
  title="Gabriele Sisinna | Personal Blog"
  description="Robotics software engineer in Bologna sharing projects, notes, prototyping work, and software architecture thinking for robotics and automation."
  jsonLd={homeJsonLd}
>
  <section class="hero fade-in">
    <div class="hero-copy">
      <p class="kicker">whoami</p>
      <h1>Gabriele Sisinna</h1>
      <p class="hero-role">Robotics software engineer in Bologna.</p>
      <p class="hero-bio">
        I build software for simulation, control, and system integration, with a strong focus on
        architecture. When a project needs fast iteration on real hardware, I also work hands-on with
        Linux, electronics, and rapid prototyping.
      </p>
      <div class="hero-actions">
        <a href="/journal/" class="button button-primary">Read the notes</a>
        <a class="button" href={githubUrl} target="_blank" rel="noreferrer noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.36 6.84 9.71.5.1.68-.22.68-.5 0-.24-.01-1.03-.01-1.87-2.78.62-3.37-1.21-3.37-1.21-.46-1.2-1.11-1.52-1.11-1.52-.91-.64.07-.63.07-.63 1 .08 1.53 1.06 1.53 1.06.9 1.57 2.35 1.12 2.92.86.09-.67.35-1.12.64-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.74 0 0 .84-.28 2.75 1.05A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.52.37 1.91-1.33 2.75-1.05 2.75-1.05.55 1.43.2 2.48.1 2.74.64.72 1.03 1.64 1.03 2.76 0 3.94-2.34 4.8-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .28.18.61.69.5A10.26 10.26 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z"
            />
          </svg>
          GitHub
        </a>
        <a class="button" href={linkedInUrl} target="_blank" rel="noreferrer noopener">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill="currentColor"
              d="M6.94 8.5A1.56 1.56 0 1 0 6.9 5.38a1.56 1.56 0 0 0 .04 3.12ZM5.6 9.67h2.62V18H5.6V9.67Zm4.27 0h2.51v1.14h.03c.35-.66 1.2-1.35 2.47-1.35 2.64 0 3.12 1.78 3.12 4.1V18h-2.61v-3.91c0-.93-.02-2.13-1.27-2.13-1.28 0-1.48 1.03-1.48 2.06V18H9.87V9.67Z"
            />
          </svg>
          LinkedIn
        </a>
        <a class="button" href="/contact/">Contact</a>
      </div>
    </div>
    <figure class="hero-avatar">
      <img
        src="/avatar-profile.jpg"
        alt="Gabriele Sisinna working on a humanoid robot"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="240"
        height="240"
      />
    </figure>
  </section>

  <section id="recent" class="section" aria-labelledby="recent-title">
    <div class="section-head">
      <div>
        <p class="kicker">ls ~/notes</p>
        <h2 id="recent-title">Latest notes</h2>
      </div>
      <a href="/journal/" class="text-link">All notes →</a>
    </div>
    <div class="post-list">
      {latest.map((entry) => <PostRow entry={entry} headingLevel="h3" />)}
    </div>
  </section>

  <section id="experience" class="section" aria-labelledby="experience-title">
    <div>
      <p class="kicker">cat experience.log</p>
      <h2 id="experience-title">Experience</h2>
    </div>
    <ol class="timeline">
      {experience.map((item, index) => (
        <li class:list={["timeline-item", index === 0 && "current"]}>
          <p class="timeline-period">{item.period}</p>
          <div class="timeline-body">
            <h3>{item.role}</h3>
            <p class="timeline-place">{item.place}</p>
            <p class="muted">{item.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="skills" class="section" aria-labelledby="skills-title">
    <div>
      <p class="kicker">cat skills.txt</p>
      <h2 id="skills-title">Skills &amp; background</h2>
    </div>
    <div class="skills-grid">
      <div class="panel">
        <h3 class="panel-title">Toolbox</h3>
        <dl class="skill-list">
          {skillGroups.map((group) => (
            <div>
              <dt>{group.title}</dt>
              <dd class="meta-row">{group.items.map((item) => <span class="pill">{item}</span>)}</dd>
            </div>
          ))}
          <div>
            <dt>Languages</dt>
            <dd>Italian (native) · English (professional)</dd>
          </div>
        </dl>
      </div>
      <div class="panel">
        <h3 class="panel-title">Education</h3>
        <ul class="plain-list">
          {education.map((item) => (
            <li>
              <span>{item.title}</span>
              <span class="muted">{item.school} · {item.period}</span>
            </li>
          ))}
        </ul>
        <h3 class="panel-title">Certifications <span class="muted">· LinkedIn Learning</span></h3>
        <ul class="plain-list">
          {certifications.map((cert) => (
            <li class="plain-list-row">
              <span>{cert.title}</span>
              <span class="muted">{cert.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-title">
    <div>
      <p class="kicker">cat about.md</p>
      <h2 id="about-title">Outside work</h2>
    </div>
    <p class="about-intro">
      I'm from Sicily, near Mount Etna, and I try to stay close to the things that keep me grounded:
      music, riding, photography, running, books, and time in nature with friends.
    </p>
    <div class="hobby-grid">
      {hobbies.map((item) => (
        <div class="panel">
          <h3>{item.label}</h3>
          <p class="muted">{item.value}</p>
        </div>
      ))}
    </div>
  </section>

  <style>
    .hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: clamp(1.5rem, 5vw, 3.5rem);
      align-items: center;
      padding-top: clamp(0.5rem, 3vw, 2rem);
    }

    .hero-copy {
      display: grid;
      gap: 1rem;
      min-width: 0;
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: clamp(1.05rem, 2.2vw, 1.25rem);
      color: var(--accent);
    }

    .hero-bio {
      max-width: 58ch;
      font-size: 1.08rem;
      color: var(--muted);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.6rem;
      margin-top: 0.5rem;
    }

    .hero-avatar {
      margin: 0;
      width: clamp(9rem, 22vw, 15rem);
      aspect-ratio: 1;
      border-radius: 50%;
      padding: 3px;
      background: linear-gradient(140deg, var(--accent), rgba(94, 230, 160, 0.08) 55%, var(--accent-warm));
    }

    .hero-avatar img {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 50%;
      object-fit: cover;
      object-position: 46% 38%;
      border: 4px solid var(--bg);
    }

    .timeline {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      --period-w: 8rem;
    }

    .timeline-item {
      position: relative;
      display: grid;
      grid-template-columns: var(--period-w) minmax(0, 1fr);
      gap: 2.5rem;
      padding-bottom: 1.75rem;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    /* Rail and dot sit in the middle of the column gap */
    .timeline-item::before {
      content: "";
      position: absolute;
      left: calc(var(--period-w) + 1.25rem);
      top: 0.55rem;
      bottom: -0.55rem;
      width: 1px;
      background: var(--line-strong);
    }

    .timeline-item:last-child::before {
      display: none;
    }

    .timeline-item::after {
      content: "";
      position: absolute;
      left: calc(var(--period-w) + 1.25rem - 4px);
      top: 0.4rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--bg);
      border: 1.5px solid var(--muted);
    }

    .timeline-item.current::after {
      border-color: var(--accent);
      background: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-dim);
    }

    .timeline-period {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--muted);
      padding-top: 0.1rem;
      text-align: right;
    }

    .timeline-item.current .timeline-period {
      color: var(--accent);
    }

    .timeline-body {
      display: grid;
      gap: 0.25rem;
      max-width: 62ch;
    }

    .timeline-place {
      font-size: 0.92rem;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .skills-grid .panel {
      display: grid;
      gap: 1rem;
    }

    .panel-title {
      font-size: 0.95rem;
    }

    .panel-title .muted {
      font-weight: 400;
    }

    .plain-list + .panel-title {
      margin-top: 0.5rem;
    }

    .skill-list {
      margin: 0;
      display: grid;
      gap: 1rem;
    }

    .skill-list dt {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }

    .skill-list dd {
      margin: 0;
      font-size: 0.92rem;
    }

    .skill-list .pill {
      color: var(--ink);
    }

    .plain-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.7rem;
      font-size: 0.92rem;
    }

    .plain-list li {
      display: grid;
      gap: 0.1rem;
    }

    .plain-list li.plain-list-row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1rem;
      align-items: baseline;
    }

    .plain-list .muted {
      font-size: 0.85rem;
    }

    .about-intro {
      max-width: 64ch;
      font-size: 1.08rem;
    }

    .hobby-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .hobby-grid .panel {
      display: grid;
      gap: 0.4rem;
      align-content: start;
    }

    .hobby-grid .muted {
      font-size: 0.94rem;
    }

    @media (max-width: 820px) {
      .skills-grid,
      .hobby-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 640px) {
      .hero {
        grid-template-columns: 1fr;
      }

      .hero-avatar {
        order: -1;
        width: 7.5rem;
      }

      .hero-actions .button-primary {
        flex-basis: 100%;
      }

      .timeline-item {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.3rem;
        padding-left: 1.5rem;
      }

      .timeline-item::before {
        left: 0.25rem;
      }

      .timeline-item::after {
        left: calc(0.25rem - 4px);
      }

      .timeline-period {
        text-align: left;
      }
    }
  </style>
</BaseLayout>
