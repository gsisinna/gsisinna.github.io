---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Image, getImage } from "astro:assets";
import PostRow from "../components/PostRow.astro";
import FeaturedPost from "../components/FeaturedPost.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "../components/Icon.astro";
import { getProjects, getPublishedJournalEntries } from "../lib/content";
import {
  profile,
  focusAreas,
  facts,
  experience,
  skillGroups,
  education,
  certifications,
  hobbies
} from "../data/profile";

const entries = await getPublishedJournalEntries();
const avatarForSchema = await getImage({ src: profile.avatar, width: 200, format: "jpg" });
const [featured, ...rest] = entries;
const recent = rest.slice(0, 3);
const projects = await getProjects();
const featuredProjects = projects.filter((project) => project.data.featured).slice(0, 2);

// Chapters of the home page journey (side rail on wide screens).
const chapters = [
  { id: "top", label: "whoami" },
  { id: "work", label: "work" },
  ...(featuredProjects.length > 0 ? [{ id: "projects", label: "projects" }] : []),
  ...(featured ? [{ id: "writing", label: "writing" }] : []),
  { id: "experience", label: "experience" },
  { id: "skills", label: "skills" },
  { id: "about", label: "life" },
  { id: "contact", label: "say hi" }
];
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const homeUrl = new URL("/", siteUrl).toString();
const notesUrl = new URL("/journal/", siteUrl).toString();
const contactUrl = new URL("/contact/", siteUrl).toString();
const searchUrl = new URL("/search/", siteUrl).toString();
const homeJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: profile.handle,
    url: homeUrl,
    description: profile.siteDescription,
    inLanguage: "en",
    potentialAction: {
      "@type": "SearchAction",
      target: `${searchUrl}?q={search_term_string}`,
      "query-input": "required name=search_term_string"
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "Person",
    name: profile.name,
    url: homeUrl,
    image: new URL(avatarForSchema.src, siteUrl).toString(),
    jobTitle: profile.role,
    description: profile.shortBio,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Bologna",
      addressCountry: "IT"
    },
    alumniOf: education.map((item) => ({ "@type": "CollegeOrUniversity", name: item.school })),
    knowsAbout: [...new Set(skillGroups.flatMap((group) => group.items))],
    sameAs: [profile.links.github, profile.links.linkedin],
    mainEntityOfPage: homeUrl
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Main site sections",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", url: homeUrl },
      { "@type": "ListItem", position: 2, name: "Notes", url: notesUrl },
      { "@type": "ListItem", position: 3, name: "Contact", url: contactUrl }
    ]
  }
];
---

<BaseLayout
  title={`${profile.name} · ${profile.role}`}
  description={profile.siteDescription}
  jsonLd={homeJsonLd}
  readingProgress
>
  <nav class="journey" aria-label="Page chapters" data-journey>
    <span class="journey-track" aria-hidden="true"><span class="journey-fill" data-journey-fill></span></span>
    <ol>
      {chapters.map((chapter, index) => (
        <li>
          <a href={`#${chapter.id}`} data-journey-link>
            <span class="journey-dot" aria-hidden="true"></span>
            <span class="journey-label"><span class="journey-no">{String(index + 1).padStart(2, "0")}</span>{chapter.label}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <section id="top" class="hero fade-in" aria-labelledby="hero-title" data-robot-area>
    <div class="hero-copy">
      <div class="hero-id">
        <figure class="hero-avatar">
          <Image
            src={profile.avatar}
            alt={profile.avatarAlt}
            widths={[64, 128, 200]}
            sizes="64px"
            loading="eager"
            fetchpriority="high"
          />
        </figure>
        <div class="hero-id-text">
          <p class="kicker">whoami</p>
          <p class="hero-status">
            <span class="status-dot" aria-hidden="true"></span>
            Now: {experience[0].role} at {experience[0].place.split(" · ")[0]}
          </p>
        </div>
      </div>
      <h1 id="hero-title">{profile.name}</h1>
      <p class="hero-role">{profile.role} · {profile.location}</p>
      <p class="hero-headline">{profile.headline}</p>
      <p class="hero-intro">{profile.intro}</p>
      <div class="hero-actions">
        <a href="/journal/" class="button button-primary">
          Read my notes
          <Icon name="arrow" />
        </a>
        <a class="button" href={profile.links.contact}>
          <Icon name="mail" />
          Get in touch
        </a>
        <div class="hero-socials">
          <a class="icon-button" href={profile.links.github} target="_blank" rel="noreferrer noopener" aria-label="GitHub" title="GitHub">
            <Icon name="github" />
          </a>
          <a class="icon-button" href={profile.links.linkedin} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" title="LinkedIn">
            <Icon name="linkedin" />
          </a>
          <a class="icon-button" href={profile.links.rss} aria-label="RSS feed" title="RSS feed">
            <Icon name="rss" />
          </a>
        </div>
      </div>
    </div>
    <figure class="robot-scene" data-robot-scene aria-hidden="true">
      <canvas></canvas>
      <figcaption class="robot-hud">
        <pre class="robot-readout" data-robot-readout>q0 +000.0°  q1 +000.0°  q2 +000.0°
tcp x 0.00  y 0.00  z 0.00</pre>
        <span class="robot-hint">move your pointer · live inverse kinematics</span>
      </figcaption>
    </figure>
  </section>

  <dl class="facts" aria-label="At a glance" data-reveal="stagger">
    {facts.map((fact) => (
      <div class="fact">
        <dt>{fact.label}</dt>
        <dd>{fact.value}</dd>
      </div>
    ))}
  </dl>

  <section id="work" class="section" aria-labelledby="focus-title" data-reveal>
    <div>
      <p class="kicker">ls ~/work</p>
      <h2 id="focus-title">What I work on</h2>
    </div>
    <div class="focus-grid" data-reveal="stagger">
      {focusAreas.map((area) => (
        <div class="panel focus-card lift" data-tilt>
          <span class="focus-icon"><Icon name={area.icon} /></span>
          <h3>{area.title}</h3>
          <p class="muted">{area.text}</p>
        </div>
      ))}
    </div>
  </section>

  {featuredProjects.length > 0 && (
    <section id="projects" class="section" aria-labelledby="projects-title" data-reveal>
      <div class="section-head">
        <div>
          <p class="kicker">ls ~/projects</p>
          <h2 id="projects-title">Selected projects</h2>
          <p class="section-lead">Open-source work: real-time control in C++ and robot architectures in ROS.</p>
        </div>
        <a href="/projects/" class="text-link">All {projects.length} projects →</a>
      </div>
      <div class="home-projects" data-reveal="stagger">
        {featuredProjects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  )}

  {featured && (
    <section id="writing" class="section" aria-labelledby="writing-title" data-reveal>
      <div class="section-head">
        <div>
          <p class="kicker">ls ~/notes</p>
          <h2 id="writing-title">Writing</h2>
          <p class="section-lead">Long-form notes on robotics software, architecture, and the projects I build.</p>
        </div>
        <a href="/journal/" class="text-link">All {entries.length} notes →</a>
      </div>
      <FeaturedPost entry={featured} />
      {recent.length > 0 && (
        <div class="post-list" data-reveal="stagger">
          {recent.map((entry) => <PostRow entry={entry} headingLevel="h3" showImage={false} />)}
        </div>
      )}
    </section>
  )}

  <section id="experience" class="section" aria-labelledby="experience-title" data-reveal>
    <div>
      <p class="kicker">cat experience.log</p>
      <h2 id="experience-title">Experience</h2>
    </div>
    <ol class="timeline" data-reveal="stagger" data-timeline>
      {experience.map((item, index) => (
        <li class:list={["timeline-item", index === 0 && "current"]}>
          <p class="timeline-period">{item.period}</p>
          <div class="timeline-body">
            <h3>{item.role}</h3>
            <p class="timeline-place">{item.place}</p>
            <p class="muted">{item.note}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <section id="skills" class="section" aria-labelledby="skills-title" data-reveal>
    <div>
      <p class="kicker">cat skills.txt</p>
      <h2 id="skills-title">Skills &amp; background</h2>
    </div>
    <div class="skills-grid" data-reveal="stagger">
      <div class="panel">
        <h3 class="panel-title">Toolbox</h3>
        <dl class="skill-list">
          {skillGroups.map((group) => (
            <div>
              <dt>{group.title}</dt>
              <dd class="meta-row">{group.items.map((item) => <span class="pill">{item}</span>)}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="panel">
        <h3 class="panel-title">Education</h3>
        <ul class="plain-list">
          {education.map((item) => (
            <li>
              <span>{item.title}</span>
              <span class="muted">{item.school} · {item.period}</span>
            </li>
          ))}
        </ul>
        <h3 class="panel-title">Certifications <span class="muted">· LinkedIn Learning</span></h3>
        <ul class="plain-list">
          {certifications.map((cert) => (
            <li class="plain-list-row">
              <span>{cert.title}</span>
              <span class="muted">{cert.year}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section id="about" class="section" aria-labelledby="about-title" data-reveal>
    <div>
      <p class="kicker">cat about.md</p>
      <h2 id="about-title">Outside work</h2>
    </div>
    <p class="about-intro">
      I'm from Sicily, near Mount Etna, and I try to stay close to the things that keep me grounded:
      music, riding, photography, running, books, and time in nature with friends.
    </p>
    <div class="hobby-grid" data-reveal="stagger">
      {hobbies.map((item) => (
        <div class="panel">
          <h3>{item.label}</h3>
          <p class="muted">{item.value}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="contact" class="cta" aria-labelledby="cta-title" data-reveal>
    <div>
      <h2 id="cta-title">Building something with robots?</h2>
      <p class="muted">
        I'm happy to talk about robotics software, architecture reviews, simulation, or hands-on prototyping.
      </p>
    </div>
    <div class="cta-actions">
      <a class="button button-primary" href={profile.links.contact}>Get in touch</a>
      <a class="button" href={profile.links.linkedin} target="_blank" rel="noreferrer noopener">
        <Icon name="linkedin" />
        LinkedIn
      </a>
    </div>
  </section>

  <script src="../scripts/home-page.ts"></script>

  <style>
    .hero {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
      gap: clamp(1.5rem, 4vw, 3rem);
      align-items: center;
      padding-top: clamp(0.5rem, 3vw, 2rem);
    }

    .hero-id {
      display: flex;
      align-items: center;
      gap: 0.85rem;
    }

    .hero-id-text {
      display: grid;
      gap: 0.4rem;
      justify-items: start;
      min-width: 0;
    }

    /* Interactive robot arm (src/scripts/robot-arm.ts) */
    .robot-scene {
      position: relative;
      margin: 0;
      width: 100%;
      max-width: 30rem;
      aspect-ratio: 1;
      justify-self: end;
      touch-action: pan-y;
    }

    .robot-scene canvas {
      display: block;
      width: 100%;
      height: 100%;
    }

    .robot-scene::before {
      content: "";
      position: absolute;
      inset: 8% 4% 12%;
      z-index: -1;
      border-radius: 50%;
      background: radial-gradient(closest-side, var(--accent-dim), transparent);
      opacity: 0.7;
    }

    .robot-hud {
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      display: grid;
      gap: 0.3rem;
      justify-items: center;
      pointer-events: none;
    }

    .robot-readout {
      margin: 0;
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.68rem;
      line-height: 1.5;
      text-align: left;
      white-space: pre;
      font-variant-numeric: tabular-nums;
    }

    .robot-hint {
      color: var(--faint);
      font-family: var(--font-mono);
      font-size: 0.68rem;
    }

    @media (hover: none) {
      .robot-hint {
        display: none;
      }
    }

    /* Chapter rail: fixed on wide screens, hidden otherwise */
    .journey {
      display: none;
    }

    @media (min-width: 1240px) {
      .journey {
        position: fixed;
        top: 50%;
        left: max(1.25rem, calc(50% - var(--max) / 2 - 8.5rem));
        z-index: 10;
        display: block;
        transform: translateY(-50%);
      }
    }

    .journey ol {
      position: relative;
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 1.1rem;
    }

    .journey-track {
      position: absolute;
      top: 0.35rem;
      bottom: 0.35rem;
      left: 0.3rem;
      width: 1px;
      background: var(--line-strong);
    }

    .journey-fill {
      position: absolute;
      inset: 0;
      background: var(--accent);
      transform: scaleY(0);
      transform-origin: top;
    }

    .journey a {
      position: relative;
      display: flex;
      align-items: center;
      gap: 0.75rem;
      color: var(--faint);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-decoration: none;
    }

    .journey-dot {
      width: 0.65rem;
      height: 0.65rem;
      flex-shrink: 0;
      border: 1.5px solid var(--faint);
      border-radius: 50%;
      background: var(--bg);
      transition: border-color 200ms ease, background-color 200ms ease, transform 200ms var(--ease-out);
    }

    .journey-label {
      display: flex;
      gap: 0.4rem;
      opacity: 0;
      transform: translateX(-4px);
      transition: opacity 200ms ease, transform 200ms var(--ease-out), color 200ms ease;
      white-space: nowrap;
    }

    .journey-no {
      color: var(--faint);
    }

    .journey:hover .journey-label,
    .journey a:focus-visible .journey-label,
    .journey a.is-active .journey-label {
      opacity: 1;
      transform: none;
    }

    .journey a:hover,
    .journey a.is-active {
      color: var(--ink-strong);
    }

    .journey a.is-active .journey-dot {
      border-color: var(--accent);
      background: var(--accent);
      transform: scale(1.15);
      box-shadow: 0 0 0 4px var(--accent-dim);
    }

    .hero-copy {
      display: grid;
      gap: 1rem;
      min-width: 0;
    }

    .hero-role {
      font-family: var(--font-mono);
      font-size: 0.95rem;
      color: var(--accent);
    }

    .hero-headline {
      max-width: 22ch;
      color: var(--ink-strong);
      font-size: clamp(1.45rem, 3.4vw, 2.1rem);
      font-weight: 500;
      line-height: 1.25;
      letter-spacing: -0.015em;
      text-wrap: balance;
    }

    .hero-intro {
      max-width: 56ch;
      font-size: 1.06rem;
      color: var(--muted);
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem;
      margin-top: 0.5rem;
    }

    .hero-socials {
      display: flex;
      gap: 0.35rem;
      margin-left: 0.35rem;
    }

    .icon-button {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 9px;
      color: var(--muted);
      font-size: 1.1rem;
      transition: color 140ms ease, background-color 140ms ease;
    }

    .icon-button:hover {
      color: var(--ink-strong);
      background: var(--hover);
    }

    .hero-avatar {
      flex-shrink: 0;
      margin: 0;
      width: 4rem;
      aspect-ratio: 1;
      border-radius: 50%;
      padding: 2px;
      background: linear-gradient(140deg, var(--accent), var(--accent-dim) 55%, var(--accent-warm));
    }

    .hero-avatar img {
      width: 100%;
      height: 100%;
      display: block;
      border-radius: 50%;
      object-fit: cover;
      object-position: 46% 38%;
      border: 3px solid var(--bg);
    }

    .hero-status {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 999px;
      background: var(--surface);
      color: var(--muted);
      font-family: var(--font-mono);
      font-size: 0.72rem;
      line-height: 1.4;
    }

    .status-dot {
      width: 0.45rem;
      height: 0.45rem;
      border-radius: 50%;
      background: var(--accent);
      box-shadow: 0 0 0 3px var(--accent-dim);
    }

    .facts {
      margin: calc(clamp(3rem, 8vw, 4.5rem) * -0.4) 0 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      border-block: 1px solid var(--line);
    }

    .fact {
      display: flex;
      flex-direction: column-reverse;
      /* With column-reverse, flex-end keeps content top-aligned */
      justify-content: flex-end;
      gap: 0.2rem;
      padding: 1.1rem 1.25rem;
    }

    .fact + .fact {
      border-left: 1px solid var(--line);
    }

    .fact dt {
      color: var(--muted);
      font-size: 0.82rem;
    }

    .fact dd {
      margin: 0;
      color: var(--ink-strong);
      font-family: var(--font-mono);
      font-weight: 600;
      font-size: 0.95rem;
    }

    .section-lead {
      margin-top: 0.5rem;
      color: var(--muted);
      max-width: 60ch;
    }

    .focus-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 1rem;
    }

    .focus-card {
      display: grid;
      align-content: start;
      gap: 0.6rem;
      padding: 1.4rem;
    }

    .focus-icon {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      margin-bottom: 0.35rem;
      border-radius: 10px;
      background: var(--accent-dim);
      color: var(--accent);
      font-size: 1.25rem;
    }

    .home-projects {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .focus-card .muted {
      font-size: 0.95rem;
    }

    .timeline {
      position: relative;
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      --period-w: 8rem;
      --rail-x: calc(var(--period-w) + 1.25rem);
    }

    /* Accent rail that fills as you scroll (src/scripts/home-page.ts sets --timeline-progress) */
    .timeline::after {
      content: "";
      position: absolute;
      top: 0.55rem;
      bottom: 0.55rem;
      left: var(--rail-x);
      width: 1px;
      background: linear-gradient(var(--accent), var(--accent-warm));
      transform: scaleY(var(--timeline-progress, 0));
      transform-origin: top;
      pointer-events: none;
    }

    .timeline-item h3 {
      transition: color 300ms ease;
    }

    .timeline-item.is-passed::after {
      border-color: var(--accent);
      background: var(--accent-dim);
    }

    .timeline-item {
      position: relative;
      display: grid;
      grid-template-columns: var(--period-w) minmax(0, 1fr);
      gap: 2.5rem;
      padding-bottom: 1.75rem;
    }

    .timeline-item:last-child {
      padding-bottom: 0;
    }

    /* Rail and dot sit in the middle of the column gap */
    .timeline-item::before {
      content: "";
      position: absolute;
      left: calc(var(--period-w) + 1.25rem);
      top: 0.55rem;
      bottom: -0.55rem;
      width: 1px;
      background: var(--line-strong);
    }

    .timeline-item:last-child::before {
      display: none;
    }

    .timeline-item::after {
      content: "";
      position: absolute;
      left: calc(var(--period-w) + 1.25rem - 4px);
      top: 0.4rem;
      width: 9px;
      height: 9px;
      border-radius: 50%;
      background: var(--bg);
      border: 1.5px solid var(--muted);
    }

    .timeline-item.current::after {
      border-color: var(--accent);
      background: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-dim);
    }

    .timeline-period {
      font-family: var(--font-mono);
      font-size: 0.82rem;
      color: var(--muted);
      padding-top: 0.1rem;
      text-align: right;
    }

    .timeline-item.current .timeline-period {
      color: var(--accent);
    }

    .timeline-body {
      display: grid;
      gap: 0.25rem;
      max-width: 62ch;
    }

    .timeline-place {
      font-size: 0.92rem;
    }

    .skills-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 1rem;
      align-items: start;
    }

    .skills-grid .panel {
      display: grid;
      gap: 1rem;
    }

    .panel-title {
      font-size: 0.95rem;
    }

    .panel-title .muted {
      font-weight: 400;
    }

    .plain-list + .panel-title {
      margin-top: 0.5rem;
    }

    .skill-list {
      margin: 0;
      display: grid;
      gap: 1rem;
    }

    .skill-list dt {
      font-family: var(--font-mono);
      font-size: 0.78rem;
      color: var(--muted);
      margin-bottom: 0.4rem;
    }

    .skill-list dd {
      margin: 0;
    }

    .skill-list .pill {
      color: var(--ink);
    }

    .plain-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: grid;
      gap: 0.7rem;
