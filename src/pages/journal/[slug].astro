---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate, slugifyTag } from "../../lib/content";

export async function getStaticPaths() {
  const entries = await getCollection("journal", ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing slug param");
}

const entry = await getEntry("journal", slug);

if (!entry || entry.data.draft) {
  return Astro.redirect("/journal/");
}

const { Content } = await render(entry);
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const postUrl = new URL(`/journal/${entry.id}/`, siteUrl).toString();
const homeUrl = new URL("/", siteUrl).toString();
const githubUrl = "https://github.com/gsisinna";
const linkedInUrl = "https://www.linkedin.com/in/gabriele-sisinna-4a6081109/";
const publishedIso = entry.data.date.toISOString();
const postImage = entry.data.image ?? "/og-article-default.svg";
const postImageUrl = new URL(postImage, siteUrl).toString();
const allPosts = await getCollection("journal", ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((post) => post.id !== entry.id)
  .map((post) => {
    const sharedTags = post.data.tags.filter((tag) => entry.data.tags.includes(tag));
    return { post, sharedTags, score: sharedTags.length };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  })
  .slice(0, 3);
const postJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.excerpt,
  datePublished: publishedIso,
  dateModified: publishedIso,
  url: postUrl,
  mainEntityOfPage: postUrl,
  inLanguage: "en",
  keywords: entry.data.tags.join(", "),
  image: postImageUrl,
  author: {
    "@type": "Person",
    name: "Gabriele Sisinna"
  },
  publisher: {
    "@type": "Person",
    name: "Gabriele Sisinna"
  }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "Notes", item: new URL("/journal/", siteUrl).toString() },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: postUrl }
  ]
};
---

<BaseLayout
  title={`${entry.data.title} | gsisinna`}
  description={entry.data.excerpt}
  image={postImage}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={publishedIso}
  tags={entry.data.tags}
  jsonLd={[postJsonLd, breadcrumbJsonLd]}
>
  <article class="post">
    <header class="post-header fade-in">
      <a href="/journal/" class="text-link">← All notes</a>
      <h1>{entry.data.title}</h1>
      <p class="post-lead">{entry.data.excerpt}</p>
      <div class="meta-line">
        <time datetime={publishedIso}>{formatDate(entry.data.date)}</time>
        {entry.data.readingTime && <span>{entry.data.readingTime}</span>}
      </div>
      {entry.data.tags.length > 0 && (
        <div class="meta-row" aria-label="Tags">
          {entry.data.tags.map((tag) => (
            <a class="pill" href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )}
    </header>

    {entry.data.image && (
      <figure class="post-cover">
        <img src={entry.data.image} alt="" loading="eager" decoding="async" referrerpolicy="no-referrer" />
      </figure>
    )}

    <div class="prose">
      <Content />
    </div>

    <aside class="post-author" aria-label="About the author">
      <img src="/avatar-profile.jpg" alt="" loading="lazy" decoding="async" width="64" height="64" />
      <div class="post-author-body">
        <p class="post-author-name">Written by Gabriele Sisinna</p>
        <p class="muted">
          Robotics software engineer working on C++, Python, simulation, control, and system integration.
        </p>
        <div class="post-author-links">
          <a href="/rss.xml">RSS</a>
          <a href={githubUrl} target="_blank" rel="noreferrer noopener">GitHub</a>
          <a href={linkedInUrl} target="_blank" rel="noreferrer noopener">LinkedIn</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
    </aside>
  </article>

  {relatedPosts.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="section-head">
        <h2 id="related-title">Related notes</h2>
        <a href="/journal/" class="text-link">All notes →</a>
      </div>
      <div class="related-grid">
        {relatedPosts.map(({ post }) => (
          <a href={`/journal/${post.id}/`} class="related-card">
            {post.data.image && (
              <img src={post.data.image} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" />
            )}
            <div class="related-body">
              <span class="meta-line">{formatDate(post.data.date)}</span>
              <h3>{post.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<style>
  .post {
    display: grid;
    gap: 2.25rem;
    min-width: 0;
  }

  .post-header {
    display: grid;
    gap: 1rem;
    max-width: 70ch;
  }

  .post-header h1 {
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    line-height: 1.12;
  }

  .post-lead {
    font-size: 1.15rem;
    color: var(--muted);
  }

  .post-cover {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .post-cover img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
  }

  .post-author {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    max-width: 70ch;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .post-author img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .post-author-body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .post-author-name {
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .post-author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .post-author-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .post-author-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .related-card {
    display: grid;
    align-content: start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
    transition: border-color 140ms ease;
  }

  .related-card:hover {
    border-color: rgba(94, 230, 160, 0.4);
  }

  .related-card:hover h3 {
    color: var(--accent);
  }

  .related-card img {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    display: block;
    border-bottom: 1px solid var(--line);
  }

  .related-body {
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
  }

  .related-body h3 {
    font-size: 0.98rem;
    line-height: 1.3;
    transition: color 140ms ease;
  }
</style>
