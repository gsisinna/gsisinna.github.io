---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { formatDate, getReadingTime, isVisible, slugifyTag } from "../../lib/content";
import { profile } from "../../data/profile";
import CoverImage from "../../components/CoverImage.astro";
import { Image } from "astro:assets";

export async function getStaticPaths() {
  const entries = await getCollection("journal", isVisible);
  return entries.map((entry) => ({ params: { slug: entry.id } }));
}

const { slug } = Astro.params;

if (!slug) {
  throw new Error("Missing slug param");
}

const entry = await getEntry("journal", slug);

if (!entry || !isVisible(entry)) {
  return Astro.redirect("/journal/");
}

const { Content, headings } = await render(entry);
const toc = headings.filter((heading) => heading.depth === 2);
const showToc = toc.length >= 3;
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const postUrl = new URL(`/journal/${entry.id}/`, siteUrl).toString();
const homeUrl = new URL("/", siteUrl).toString();
const publishedIso = entry.data.date.toISOString();
const updatedIso = entry.data.updated?.toISOString() ?? publishedIso;
const postImage = entry.data.image ?? "/og-default.png";
const postImageUrl = new URL(postImage, siteUrl).toString();
const allPosts = await getCollection("journal", isVisible);
const relatedPosts = allPosts
  .filter((post) => post.id !== entry.id)
  .map((post) => {
    const sharedTags = post.data.tags.filter((tag) => entry.data.tags.includes(tag));
    return { post, sharedTags, score: sharedTags.length };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => {
    if (b.score !== a.score) return b.score - a.score;
    return b.post.data.date.getTime() - a.post.data.date.getTime();
  })
  .slice(0, 3);
const postJsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: entry.data.title,
  description: entry.data.excerpt,
  datePublished: publishedIso,
  dateModified: updatedIso,
  url: postUrl,
  mainEntityOfPage: postUrl,
  inLanguage: "en",
  keywords: entry.data.tags.join(", "),
  image: postImageUrl,
  author: {
    "@type": "Person",
    name: profile.name,
    url: homeUrl
  },
  publisher: {
    "@type": "Person",
    name: profile.name
  }
};
const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: homeUrl },
    { "@type": "ListItem", position: 2, name: "Notes", item: new URL("/journal/", siteUrl).toString() },
    { "@type": "ListItem", position: 3, name: entry.data.title, item: postUrl }
  ]
};
---

<BaseLayout
  title={`${entry.data.title} · ${profile.name}`}
  description={entry.data.excerpt}
  image={postImage}
  type="article"
  publishedTime={publishedIso}
  modifiedTime={updatedIso}
  tags={entry.data.tags}
  jsonLd={[postJsonLd, breadcrumbJsonLd]}
  readingProgress
>
  <article class="post">
    <header class="post-header fade-in">
      <a href="/journal/" class="text-link">← All notes</a>
      <h1 transition:name={`title-${entry.id}`}>{entry.data.title}</h1>
      <p class="post-lead">{entry.data.excerpt}</p>
      <div class="meta-line">
        {entry.data.draft && <span class="draft-badge">Draft · only visible locally</span>}
        <time datetime={publishedIso}>{formatDate(entry.data.date)}</time>
        <span>{getReadingTime(entry)}</span>
        {entry.data.updated && (
          <span>Updated <time datetime={updatedIso}>{formatDate(entry.data.updated)}</time></span>
        )}
      </div>
      {entry.data.tags.length > 0 && (
        <div class="meta-row" aria-label="Tags">
          {entry.data.tags.map((tag) => (
            <a class="pill" href={`/tags/${slugifyTag(tag)}/`}>#{tag}</a>
          ))}
        </div>
      )}
    </header>

    {entry.data.image && (
      <figure class="post-cover" transition:name={`cover-${entry.id}`}>
        <CoverImage entry={entry} eager />
      </figure>
    )}

    <div class:list={["post-body", showToc && "has-toc"]}>
      {showToc && (
        <details class="toc toc-mobile">
          <summary>On this page</summary>
          <ol>
            {toc.map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
          </ol>
        </details>
      )}
      <div class="prose">
        <Content />
      </div>
      {showToc && (
        <nav class="toc toc-desktop" aria-label="On this page">
          <p class="toc-title">On this page</p>
          <ol>
            {toc.map((heading) => <li><a href={`#${heading.slug}`} data-toc-link>{heading.text}</a></li>)}
          </ol>
        </nav>
      )}
    </div>

    <aside class="post-author" aria-label="About the author" data-reveal>
      <Image src={profile.avatar} alt="" width={64} height={64} densities={[1, 2]} loading="lazy" />
      <div class="post-author-body">
        <p class="post-author-name">Written by <a href="/">{profile.name}</a></p>
        <p class="muted">{profile.shortBio}</p>
        <div class="post-author-links">
          <a href={profile.links.rss}>RSS</a>
          <a href={profile.links.github} target="_blank" rel="noreferrer noopener">GitHub</a>
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer noopener">LinkedIn</a>
          <a href={profile.links.contact}>Contact</a>
        </div>
      </div>
    </aside>
  </article>

  {relatedPosts.length > 0 && (
    <section class="section" aria-labelledby="related-title">
      <div class="section-head">
        <h2 id="related-title">Related notes</h2>
        <a href="/journal/" class="text-link">All notes →</a>
      </div>
      <div class="related-grid" data-reveal="stagger">
        {relatedPosts.map(({ post }) => (
          <a href={`/journal/${post.id}/`} class="related-card lift">
            {post.data.image && (
              <span class="related-media"><CoverImage entry={post} decorative /></span>
            )}
            <div class="related-body">
              <span class="meta-line">{formatDate(post.data.date)}</span>
              <h3>{post.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}
</BaseLayout>

<script src="../../scripts/post-page.ts"></script>

<style>
  .post-body {
    min-width: 0;
  }

  .toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.45rem;
  }

  .toc a {
    color: var(--muted);
    font-size: 0.86rem;
    line-height: 1.35;
    text-decoration: none;
    transition: color 140ms ease;
  }

  .toc a:hover,
  .toc a.is-active {
    color: var(--accent);
  }

  .toc-mobile {
    max-width: 70ch;
    margin-bottom: 2rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--surface);
  }

  .toc-mobile summary {
    cursor: pointer;
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .toc-mobile ol {
    margin-top: 0.85rem;
  }

  .toc-desktop {
    display: none;
  }

  .toc-title {
    margin-bottom: 0.85rem;
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }

  @media (min-width: 1000px) {
    .post-body.has-toc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 13.5rem;
      gap: 3rem;
      align-items: start;
    }

    .toc-mobile {
      display: none;
    }

    .toc-desktop {
      display: block;
      position: sticky;
      top: 5.5rem;
      padding-left: 1rem;
      border-left: 1px solid var(--line);
    }
  }

  .post-author-name a {
    text-decoration: none;
  }

  .post-author-name a:hover {
    color: var(--accent);
  }

  .post {
    display: grid;
    gap: 2.25rem;
    min-width: 0;
  }

  .post-header {
    display: grid;
    gap: 1rem;
    max-width: 70ch;
  }

  .post-header h1 {
    font-size: clamp(1.8rem, 4.4vw, 2.6rem);
    line-height: 1.12;
  }

  .post-lead {
    font-size: 1.15rem;
    color: var(--muted);
  }

  .post-cover {
    margin: 0;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: var(--surface);
  }

  .post-cover :global(.cover) {
    aspect-ratio: 16 / 9;
  }

  .post-cover :global(.cover-contain) {
    aspect-ratio: 2 / 1;
  }

  .post-author {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
    max-width: 70ch;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .post-author img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .post-author-body {
    display: grid;
    gap: 0.35rem;
    min-width: 0;
  }

  .post-author-name {
    color: var(--ink-strong);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .post-author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .post-author-links a {
    color: var(--accent);
    text-decoration: none;
  }

  .post-author-links a:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .related-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
  }

  .related-card {
    display: grid;
    align-content: start;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none;
  }

  .related-card:hover h3 {
    color: var(--accent);
  }

  .related-media {
    display: block;
    aspect-ratio: 16 / 9;
    border-bottom: 1px solid var(--line);
  }

  .related-media :global(.cover) {
    height: 100%;
  }

  .related-body {
    display: grid;
    gap: 0.45rem;
    padding: 1rem;
  }

  .related-body h3 {
    font-size: 0.98rem;
    line-height: 1.3;
    transition: color 140ms ease;
  }
</style>
