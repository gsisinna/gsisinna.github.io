---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import { getPublishedJournalEntries, getPublishedTagSummaries } from "../../lib/content";

const entries = await getPublishedJournalEntries();
const tags = await getPublishedTagSummaries();
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const notesUrl = new URL("/journal/", siteUrl).toString();
const notesJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Notes Archive | gsisinna",
    url: notesUrl,
    description: "Archive of robotics software notes, project logs, experiments, and technical writing by Gabriele Sisinna.",
    inLanguage: "en",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: entries.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(`/journal/${entry.id}/`, siteUrl).toString(),
        name: entry.data.title
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: "Notes", item: notesUrl }
    ]
  }
];
---

<BaseLayout
  title="Notes | gsisinna"
  description="Robotics software notes, project updates, experiments, and practical learnings."
  jsonLd={notesJsonLd}
>
  <header class="page-head fade-in">
    <p class="kicker">ls ~/notes</p>
    <h1>Notes</h1>
    <p class="lead">Project notes, experiments, build logs, and lessons learned from real work.</p>
    {tags.length > 0 && (
      <div class="meta-row" aria-label="Browse tags">
        {tags.slice(0, 8).map((tag) => (
          <a class="pill" href={`/tags/${tag.slug}/`}>#{tag.name}</a>
        ))}
        <a class="text-link" href="/tags/" style="margin-left:0.35rem;">All tags →</a>
      </div>
    )}
  </header>

  <section class="post-list" aria-label="All notes">
    {entries.map((entry) => <PostRow entry={entry} />)}
  </section>
</BaseLayout>
