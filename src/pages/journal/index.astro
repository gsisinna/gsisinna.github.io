---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostRow from "../../components/PostRow.astro";
import FeaturedPost from "../../components/FeaturedPost.astro";
import { getPublishedJournalEntries, getPublishedTagSummaries, groupByYear } from "../../lib/content";

const entries = await getPublishedJournalEntries();
const tags = await getPublishedTagSummaries();
const [featured, ...rest] = entries;
const years = groupByYear(rest);
const description =
  "Notes by Gabriele Sisinna on robotics software, ROS 2 and simulation, C++ and Python, software architecture, and the projects behind them.";
const siteUrl = Astro.site?.toString() ?? "https://gsisinna.github.io";
const notesUrl = new URL("/journal/", siteUrl).toString();
const notesJsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Notes · Gabriele Sisinna",
    url: notesUrl,
    description,
    inLanguage: "en",
    mainEntity: {
      "@type": "ItemList",
      itemListElement: entries.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(`/journal/${entry.id}/`, siteUrl).toString(),
        name: entry.data.title
      }))
    }
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: new URL("/", siteUrl).toString() },
      { "@type": "ListItem", position: 2, name: "Notes", item: notesUrl }
    ]
  }
];
---

<BaseLayout title="Notes · Gabriele Sisinna" description={description} jsonLd={notesJsonLd}>
  <header class="page-head fade-in">
    <p class="kicker">ls ~/notes</p>
    <h1>Notes</h1>
    <p class="lead">
      Writing about robotics software, architecture, and the projects I build along the way: what I tried,
      what broke, and what I would do again.
    </p>
    <p class="meta-line">
      <span>{entries.length} note{entries.length === 1 ? "" : "s"}</span>
      <span>{tags.length} topics</span>
      <a class="text-link" href="/rss.xml">RSS feed</a>
    </p>
  </header>

  {tags.length > 0 && (
    <nav class="topic-bar" aria-label="Browse by topic">
      <span class="topic-bar-label">Topics</span>
      <div class="meta-row">
        {tags.slice(0, 10).map((tag) => (
          <a class="pill" href={`/tags/${tag.slug}/`}>#{tag.name} <span class="count">{tag.count}</span></a>
        ))}
        <a class="text-link" href="/tags/">All topics →</a>
      </div>
    </nav>
  )}

  {featured && <FeaturedPost entry={featured} />}

  {years.map(([year, yearEntries]) => (
    <section class="year-group" aria-labelledby={`year-${year}`}>
      <h2 id={`year-${year}`} class="year-title">{year}</h2>
      <div class="post-list">
        {yearEntries.map((entry) => <PostRow entry={entry} />)}
      </div>
    </section>
  ))}
</BaseLayout>

<style>
  .topic-bar {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    margin-top: calc(clamp(3rem, 8vw, 4.5rem) * -0.55);
  }

  .topic-bar-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--muted);
  }

  .topic-bar .text-link {
    margin-left: 0.35rem;
  }

  .count {
    color: var(--muted);
    opacity: 0.7;
  }

  .year-group {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }

  .year-title {
    position: sticky;
    top: 5rem;
    padding-top: 1.35rem;
    color: var(--muted);
    font-size: 1.1rem;
  }

  @media (max-width: 760px) {
    .topic-bar,
    .year-group {
      grid-template-columns: 1fr;
      gap: 0.6rem;
    }

    .year-title {
      position: static;
      padding-top: 0;
    }
  }
</style>
