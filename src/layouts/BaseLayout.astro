---
import "../styles/base.css";
import { createHash } from "node:crypto";
import { ClientRouter } from "astro:transitions";
import { profile } from "../data/profile";
import Icon from "../components/Icon.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Show a reading progress bar under the header (long-form posts). */
  readingProgress?: boolean;
}

const {
  title = profile.name,
  description = profile.siteDescription,
  image = "/og-default.png",
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd = [],
  readingProgress = false
} = Astro.props;

const pathName = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(pathName, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const githubUrl = profile.links.github;
const linkedInUrl = profile.links.linkedin;
const rssUrl = new URL("/rss.xml", siteUrl).toString();
const twitterCard = "summary_large_image";
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const currentYear = new Date().getFullYear();
const pageKeywords = [...new Set(["robotics software", "C++", "Python", "software architecture", ...tags])]
  .filter(Boolean)
  .join(", ");
// Runs before first paint: frame-busting, theme (no flash), and the `js` flag.
// Re-applied after client-side navigation because the router replaces <html> attributes.
const headScript = `
if (window.top !== window.self) {
  document.documentElement.style.display = "none";
  try { window.top.location = window.self.location.href; } catch {}
}
(() => {
  const applyTheme = () => {
    let theme = null;
    try { theme = localStorage.getItem("theme"); } catch {}
    const root = document.documentElement;
    if (theme === "light" || theme === "dark") root.dataset.theme = theme;
    else delete root.dataset.theme;
    root.classList.add("js");
  };
  applyTheme();
  document.addEventListener("astro:after-swap", applyTheme);
})();
`;
const headScriptHash = `'sha256-${createHash("sha256").update(headScript).digest("base64")}'`;
// Production allows only bundled scripts plus the hashed head script.
// Dev keeps 'unsafe-inline' because Vite injects inline scripts for HMR.
const scriptSrc = import.meta.env.PROD ? `'self' ${headScriptHash}` : "'self' 'unsafe-inline'";
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "form-action https://formspree.io",
  "img-src 'self' https: data:",
  "font-src 'self' https://fonts.gstatic.com data:",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  `script-src ${scriptSrc}`,
  "connect-src 'self' https://formspree.io",
  "upgrade-insecure-requests"
].join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="author" content="Gabriele Sisinna" />
    <meta name="google-site-verification" content="xqHM9Pytu8Nzeeh02WqNgvoUIfhEfE6DkoH_TF-TZ98" />
    <meta name="theme-color" content="#0b0d0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Gabriele Sisinna · Notes" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:site_name" content="gsisinna" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600;700&display=swap"
    />
    {jsonLdItems.filter(Boolean).map((item) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
      />
    ))}
    <!-- `frame-ancestors` is ignored in meta CSP. Enforce it via HTTP headers at the host/CDN. -->
    <script is:inline set:html={headScript} />
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site" transition:name="site-header" transition:animate="none">
      <div class="container">
        <a class="brand" href="/" aria-label="gsisinna, home"><span>~/</span>gsisinna</a>
        <nav class="primary" aria-label="Primary">
          <a href="/journal/" aria-current={pathName.startsWith("/journal") ? "page" : undefined}>notes</a>
          <a href="/tags/" aria-current={pathName.startsWith("/tags") ? "page" : undefined}>topics</a>
          <a href="/contact/" aria-current={pathName.startsWith("/contact") ? "page" : undefined}>contact</a>
          <a
            href="/search/"
            class="nav-search"
            aria-label="Search (press /)"
            title="Search (press /)"
            aria-current={pathName.startsWith("/search") ? "page" : undefined}
          >
            <Icon name="search" />
          </a>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch color theme" title="Switch theme">
            <Icon name="sun" class="icon-sun" />
            <Icon name="moon" class="icon-moon" />
          </button>
        </nav>
      </div>
      {readingProgress && <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>}
    </header>
    <main id="main-content" tabindex="-1" transition:animate="fade">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="container">
        <span>© {currentYear} Gabriele Sisinna</span>
        <nav class="footer-links" aria-label="Footer">
          <a href={rssUrl}>RSS</a>
          <a href={githubUrl} target="_blank" rel="noreferrer noopener">GitHub</a>
          <a href={linkedInUrl} target="_blank" rel="noreferrer noopener">LinkedIn</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
    <button type="button" class="back-to-top" data-back-to-top aria-label="Back to top" title="Back to top">
      <Icon name="arrow-up" />
    </button>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
