---
import "../styles/base.css";
import { ClientRouter } from "astro:transitions";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  type?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Show a reading progress bar under the header (long-form posts). */
  readingProgress?: boolean;
}

const {
  title = profile.name,
  description = profile.siteDescription,
  image = "/og-default.svg",
  noindex = false,
  type = "website",
  publishedTime,
  modifiedTime,
  tags = [],
  jsonLd = [],
  readingProgress = false
} = Astro.props;

const pathName = Astro.url.pathname;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(pathName, siteUrl).toString();
const imageUrl = new URL(image, siteUrl).toString();
const githubUrl = profile.links.github;
const linkedInUrl = profile.links.linkedin;
const rssUrl = new URL("/rss.xml", siteUrl).toString();
const twitterCard = "summary_large_image";
const jsonLdItems = Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const currentYear = new Date().getFullYear();
const pageKeywords = [...new Set(["robotics software", "C++", "Python", "software architecture", ...tags])]
  .filter(Boolean)
  .join(", ");
const csp = [
  "default-src 'self'",
  "base-uri 'self'",
  "object-src 'none'",
  "form-action https://formspree.io",
  "img-src 'self' https: data:",
  "font-src 'self' https://fonts.gstatic.com data:",
  "style-src 'self' 'unsafe-inline' https://fonts.googleapis.com",
  "script-src 'self' 'unsafe-inline'",
  "connect-src 'self'",
  "upgrade-insecure-requests"
].join("; ");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={pageKeywords} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="googlebot" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <meta name="author" content="Gabriele Sisinna" />
    <meta name="google-site-verification" content="xqHM9Pytu8Nzeeh02WqNgvoUIfhEfE6DkoH_TF-TZ98" />
    <meta name="theme-color" content="#0b0d0f" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f6f7f5" media="(prefers-color-scheme: light)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content={csp} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Gabriele Sisinna · Notes" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:site_name" content="gsisinna" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={title} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {type === "article" && tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content={twitterCard} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={title} />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600;700&display=swap"
      rel="preload"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;600;700&display=swap"
        rel="stylesheet"
      />
    </noscript>
    {jsonLdItems.filter(Boolean).map((item) => (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
      />
    ))}
    <!-- `frame-ancestors` is ignored in meta CSP. Enforce it via HTTP headers at the host/CDN. -->
    <script is:inline>
      if (window.top !== window.self) {
        document.documentElement.style.display = "none";
        try {
          window.top.location = window.self.location.href;
        } catch {}
      }
      // Theme + JS flag on <html>. Re-applied after every client-side navigation,
      // because the router replaces <html> attributes with the new page's.
      const applyTheme = () => {
        let theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch {}
        const root = document.documentElement;
        if (theme === "light" || theme === "dark") root.dataset.theme = theme;
        else delete root.dataset.theme;
        root.classList.add("js");
      };
      applyTheme();
      document.addEventListener("astro:after-swap", applyTheme);
    </script>
    <ClientRouter />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <header class="site" transition:name="site-header" transition:animate="none">
      <div class="container">
        <a class="brand" href="/" aria-label="gsisinna, home"><span>~/</span>gsisinna</a>
        <nav class="primary" aria-label="Primary">
          <a href="/journal/" aria-current={pathName.startsWith("/journal") ? "page" : undefined}>notes</a>
          <a href="/tags/" aria-current={pathName.startsWith("/tags") ? "page" : undefined}>topics</a>
          <a href="/contact/" aria-current={pathName.startsWith("/contact") ? "page" : undefined}>contact</a>
          <a
            href="/search/"
            class="nav-search"
            aria-label="Search"
            aria-current={pathName.startsWith("/search") ? "page" : undefined}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="11" cy="11" r="7" />
              <path d="m20 20-3.5-3.5" />
            </svg>
          </a>
          <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch color theme">
            <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
            </svg>
          </button>
        </nav>
      </div>
      {readingProgress && <div class="reading-progress" aria-hidden="true"><span data-reading-progress></span></div>}
    </header>
    <main id="main-content" transition:animate="fade">
      <div class="container">
        <slot />
      </div>
    </main>
    <footer class="site">
      <div class="container">
        <span>© {currentYear} Gabriele Sisinna</span>
        <nav class="footer-links" aria-label="Footer">
          <a href={rssUrl}>RSS</a>
          <a href={githubUrl} target="_blank" rel="noreferrer noopener">GitHub</a>
          <a href={linkedInUrl} target="_blank" rel="noreferrer noopener">LinkedIn</a>
          <a href="/privacy/">Privacy</a>
          <a href="/terms/">Terms</a>
        </nav>
      </div>
    </footer>
    <script src="../scripts/site.ts"></script>
  </body>
</html>
