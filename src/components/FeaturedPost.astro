---
import type { CollectionEntry } from "astro:content";
import CoverImage from "./CoverImage.astro";
import { formatDate, getReadingTime } from "../lib/content";

interface Props {
  entry: CollectionEntry<"journal">;
  label?: string;
}

const { entry, label = "Latest" } = Astro.props;
const href = `/journal/${entry.id}/`;
---

<article class="featured lift" data-reveal>
  {entry.data.image && (
    <a class="featured-media" href={href} tabindex="-1" aria-hidden="true" transition:name={`cover-${entry.id}`}>
      <CoverImage entry={entry} decorative eager />
    </a>
  )}
  <div class="featured-body">
    <div class="meta-line">
      <span class="featured-label">{label}</span>
      <time datetime={entry.data.date.toISOString()}>{formatDate(entry.data.date)}</time>
      <span>{getReadingTime(entry)}</span>
    </div>
    <h3 transition:name={`title-${entry.id}`}><a href={href}>{entry.data.title}</a></h3>
    <p class="muted">{entry.data.excerpt}</p>
    <a class="text-link" href={href} aria-hidden="true" tabindex="-1">Read the note →</a>
  </div>
</article>

<style>
  .featured {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: hidden;
  }

  .featured-media {
    display: block;
    min-height: 15rem;
    border-right: 1px solid var(--line);
  }

  .featured-media :global(.cover) {
    height: 100%;
  }

  .featured-media :global(.cover img) {
    transition: transform 500ms var(--ease-out), opacity 400ms ease;
  }

  .featured:hover .featured-media :global(.cover-cover img) {
    transform: scale(1.035);
  }

  .featured-body {
    display: grid;
    align-content: center;
    gap: 0.85rem;
    padding: clamp(1.25rem, 3vw, 2rem);
  }

  .featured-label {
    color: var(--accent);
  }

  .featured h3 {
    font-size: clamp(1.2rem, 2.4vw, 1.5rem);
    line-height: 1.2;
  }

  /* Whole card is clickable via the title link */
  .featured h3 a {
    text-decoration: none;
  }

  .featured h3 a::after {
    content: "";
    position: absolute;
    inset: 0;
  }

  .featured:hover h3 a {
    color: var(--accent);
  }

  .featured .text-link {
    position: relative;
  }

  @media (max-width: 760px) {
    .featured {
      grid-template-columns: 1fr;
    }

    .featured-media {
      min-height: 0;
      aspect-ratio: 16 / 9;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
  }
</style>
